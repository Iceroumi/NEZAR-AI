{
  "manifest_version": 3,
  "name": "NEZAR — визуальный AI-агент",
  "version": "1.1.3",
  "description": "Бесплатный визуальный AI-агент: Blockly-блоки + web-чаты DeepSeek/Qwen/GLM + Native Messaging терминал. Без API-ключей и облака.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Открыть NEZAR",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.z.ai/*",
        "https://alice.yandex.ru/*",
        "https://yandex.ru/alice/*"
      ],
      "js": ["content/main.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "tabs", "nativeMessaging"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.z.ai/*",
    "https://alice.yandex.ru/*",
    "https://yandex.ru/alice/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
